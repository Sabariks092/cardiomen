# Copy to .env and fill in. Never put real values in this file: it gets committed.

# Neon. The pooled URL has -pooler in its host; the direct one does not.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Tokens. Generate each with: openssl rand -base64 48 (at least 32 characters)
JWT_SECRET=
OTP_PEPPER=
CRON_SECRET=

# Google: the OAuth "Web application" client ID
GOOGLE_WEB_CLIENT_ID=

# Email through Nodemailer. Gmail needs an App Password (2-Step Verification must be on).
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cardiomen <you@example.com>"
